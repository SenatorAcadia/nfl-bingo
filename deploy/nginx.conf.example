# Filename: deploy/nginx.conf.example
# Purpose: Proxy an HTTPS NFL BEANO location to the localhost-bound Node container.
# Version: 24.1.0

# Section 1: WebSocket connection mapping
# Place this map in nginx's http context, outside the server block.
map $http_upgrade $nfl_beano_connection_upgrade {
    default upgrade;
    '' close;
}

# Section 2: HTTPS location
# Place this location inside the intended TLS-enabled server block.
location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $nfl_beano_connection_upgrade;
    proxy_read_timeout 75s;
}
